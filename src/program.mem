03100100 // 0: LOAD_IMM R1, 0x100
0320000A // 1: LOAD_IMM R2, 0x00A
03300000 // 2: LOAD_IMM R3, 0x000
03400000 // 3: LOAD_IMM R4, 0x000
0C042000 // 4: loop: CMP R4, R2
2300000B // 5: BGE done
06514000 // 6: ADD R5, R1, R4
02650000 // 7: LOAD_IND R6, [R5]
06336000 // 8: ADD R3, R3, R6
16440001 // 9: ADDI R4, R4, 0x001
0E000004 // 10: JMP loop
04300200 // 11: done: STORE R3, 0x200
FF000000 // 12: HALT
